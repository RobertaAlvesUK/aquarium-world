<!-- Include the shared header partial -->
<%- include('partials/header') %>

<!-- Plan Your Visit page content -->
<section class="visit-page">
  <h1>Plan Your Visit</h1>
  <p>Everything you need to know before visiting Aquarium World.</p>

  <!-- Accessibility information for visitors -->
  <section class="accessibility-section" aria-labelledby="accessibility-heading">
    <div class="accessibility-content">
      <div>
        <h2 id="accessibility-heading">Accessibility and Inclusion</h2>
        <p>
          Aquarium World aims to make every visit welcoming and comfortable for all visitors.
        </p>

        <ul>
          <li>Step-free entrance and wheelchair-friendly visitor routes.</li>
          <li>Accessible viewing areas throughout the aquarium.</li>
          <li>Seating and rest areas available during the visit.</li>
          <li>Visitors can contact the Aquarium World team before visiting for additional support.</li>
        </ul>
      </div>

      <img
        class="accessibility-image"
        src="/images/accessibility/wheelchair-visitor.png"
        alt="Visitor using a wheelchair enjoying an aquarium display"
      >
    </div>
  </section>

  <!-- Travel information links -->
  <h2>Getting Here</h2>
  <p>Plan your journey before visiting Aquarium World.</p>

  <div class="transport-links">
    <article class="transport-card">
      <span class="transport-icon" aria-hidden="true">🗺️</span>
      <h3>Plan Your Route</h3>
      <p>Use an online map to plan your route before travelling.</p>
      <a
        href="https://www.google.com/maps"
        target="_blank"
        rel="noopener noreferrer"
      >
        Plan your route with Google Maps
      </a>
    </article>

    <article class="transport-card">
      <span class="transport-icon" aria-hidden="true">🚌</span>
      <h3>By Bus</h3>
      <p>Check local bus services and choose the route that suits your journey.</p>
      <a
        href="https://www.traveline.info/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Check bus journey options
      </a>
    </article>

    <article class="transport-card">
      <span class="transport-icon" aria-hidden="true">🚗</span>
      <h3>By Car</h3>
      <p>Use an online map to plan your route before travelling.</p>
      <a
        href="https://www.google.com/maps"
        target="_blank"
        rel="noopener noreferrer"
      >
        Plan your car journey
      </a>
    </article>
  </div>

  <h2>Opening Times</h2>

  <!-- Display weekly opening hours from the database -->
  <div class="opening-times-box">
    <% openingHours.forEach(hour => { %>
      <p>
        <strong><%= hour.day_name %>:</strong>
        <%= hour.opening_time %>–<%= hour.closing_time %>
      </p>
    <% } ) %>
  </div>
</section>

<!-- Include the shared footer partial -->
<%- include('partials/footer') %>
