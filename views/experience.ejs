<!-- Include the shared header partial -->
<%- include('partials/header') %>

<!-- Reusable experience page content -->
<section class="experience-page">
  <h1><%= title %></h1>
  <p class="experience-intro"><%= description %></p>

  <!-- Show an image only for experiences that provide one -->
  <% if (typeof imagePath !== 'undefined' && imagePath) { %>
    <img
      class="experience-image"
      src="<%= imagePath %>"
      alt="<%= imageAlt %>">
  <% } %>

  <h2>What to Expect</h2>
  <p><%= details %></p>

  <h2>Visitor Information</h2>
  <p><%= information %></p>
</section>

<!-- Include the shared footer partial -->
<%- include('partials/footer') %>
