<!-- Include the shared header partial -->
<%- include('partials/header') %>

<!-- Homepage hero section -->
<section class="hero">
  <div class="hero-content">
    <h1>Aquarium World</h1>
    <p class="hero-text">Explore the Universe Beneath</p>
    <p class="hero-hours">Open daily · 9am–6pm</p>
  </div>
</section>

<!-- Homepage experience and activity cards -->
<section class="home-features">
  <h2>Explore Aquarium World</h2>

  <!-- Aquarium experiences -->
  <h3>Experiences</h3>
  <div class="feature-cards experience-cards">
    <a class="feature-card" href="/ocean-lodge">
      <span class="feature-icon" aria-hidden="true">🌊</span>
      <h4>Ocean Lodge Hotel</h4>
      <p>Stay beside the underwater world and explore this special experience.</p>
      <span class="feature-link-text">Explore the Hotel</span>
    </a>

    <a class="feature-card" href="/cinema">
      <span class="feature-icon" aria-hidden="true">🎬</span>
      <h4>4D Cinema</h4>
      <p>Experience the ocean through an immersive short film.</p>
      <span class="feature-link-text">Explore the Cinema</span>
    </a>

    <a class="feature-card" href="/tunnel">
      <span class="feature-icon" aria-hidden="true">🐟</span>
      <h4>Underwater Tunnel</h4>
      <p>Walk through the tunnel and see aquarium animals around you.</p>
      <span class="feature-link-text">Explore the Tunnel</span>
    </a>

    <a class="feature-card" href="/shark-dive">
      <span class="feature-icon" aria-hidden="true">🦈</span>
      <h4>Shark Dive</h4>
      <p>Discover shark habitats, care and conservation.</p>
      <span class="feature-link-text">Explore Shark Dive</span>
    </a>
  </div>

  <!-- Interactive aquarium activities -->
  <h3>Interactive Activities</h3>
  <div class="feature-cards activity-cards">
    <a class="feature-card" href="/animal-search">
      <span class="feature-icon" aria-hidden="true">⌕</span>
      <h4>Animal Search</h4>
      <p>Find an animal and discover its aquarium zone.</p>
      <span class="feature-link-text">Find an Animal</span>
    </a>

    <a class="feature-card" href="/guess-the-fish">
      <span class="feature-icon" aria-hidden="true">🐠</span>
      <h4>Guess the Fish!</h4>
      <p>Test your aquarium knowledge in our interactive quiz.</p>
      <span class="feature-link-text">Play the Quiz</span>
    </a>
  </div>
</section>

<!-- Include the shared footer partial -->
<%- include('partials/footer') %>
